<hibernate-configuration xmlns="http://www.hibernate.org/xsd/orm/cfg">
    <session-factory>
        
        <property name="hibernate.connection.Driver">org.mysql.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/hibernate_next</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">mysql</property>

        <property name="hibernate.hbm2ddl.auto">update</property>
<!--   we are telling here to create so it will always drop table and then add data to new one if we      -->
<!--        write update then it will update it  -->
        <property name="hibernate.show_sql">true</property>
        
    </session-factory>
</hibernate-configuration>